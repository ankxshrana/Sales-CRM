# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-this-in-production-crm-secret-key-2025
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Leave blank or unset to use local SQLite in development)
# DATABASE_URL=postgresql://crm_user:crm_secret@localhost:5432/sales_crm
POSTGRES_DB=sales_crm
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
